# Copia este archivo como .env (no lo subas a git) o configura estas variables en tu hosting.

# Primer administrador del panel /admin. Al arrancar se crea esta cuenta si no existe.
# Entra con este correo y contraseña, y luego cámbiala desde tu perfil en la app.
# Más personas: desde el panel, en "Equipo" (deben crear su cuenta en la app primero).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Víctor Aguilar"

# Avisos push al celular del barbero en cada reserva nueva (opcional).
# Instala la app ntfy, suscríbete a un tema con nombre difícil de adivinar y pon aquí la URL:
NOTIFY_URL=

# --- Correos al cliente (confirmación, rechazo, cancelación y recordatorio) ---
# Usa Resend (resend.com, plan gratis de 3000 correos al mes). Crea una cuenta, verifica tu dominio
# y genera una API key. Sin estas dos variables, la app no pide el correo y no envía nada.
RESEND_API_KEY=
EMAIL_FROM="Víctor Aguilar Barbería <reservas@tu-dominio.com>"
# Opcional: adónde llegan las respuestas del cliente
EMAIL_REPLY_TO=

# Dirección pública de la app. Se usa en el enlace "Ver o cancelar mi cita" de los correos.
PUBLIC_URL=https://reservas.tu-dominio.com

# --- Copias de seguridad ---
# La app hace una copia diaria (3:00 a.m.) y guarda las últimas 7 en el disco, en /data/backups.
# Para guardarlas también FUERA del servidor, usa un almacenamiento compatible con S3 (Cloudflare R2: gratis hasta 10 GB):
BACKUP_S3_ENDPOINT=https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=elcorte-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Opcionales: BACKUP_KEEP=7  BACKUP_HOUR=3  BACKUP_S3_PREFIX=backups/  BACKUP_S3_REGION=auto

# Puerto y archivo de la base de datos
PORT=8080
DB_FILE=./data/barberia.db

# Pon 1 si el servidor está detrás de un proxy (Railway, Render, Fly, Nginx)
TRUST_PROXY=1
